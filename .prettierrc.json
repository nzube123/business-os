{
  "$schema": "https://json.schemastore.org/prettierrc",

  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,

  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,

  "trailingComma": "none",

  "arrowParens": "always",

  "bracketSpacing": true,
  "bracketSameLine": false,

  "endOfLine": "lf",

  "proseWrap": "preserve"
}